# Copy this file to .env and fill in the keys you have.
# The app works with no keys at all — it runs in demo mode, serving
# pre-seeded businesses/reviews/competitors from services/demo_data.py
# with zero external API calls. See README.md for details.

# Required for AI analysis (/api/analysis/analyze), reply generation
# (/api/replies/generate), and weekly reports (/api/analysis/report).
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# SerpAPI keys — add up to 5 slots for round-robin rotation + 429 fallback.
# All non-empty values are pooled automatically.  You only need one to get started.
# SERPAPI_KEY is the legacy single-key slot (slot 1); SERPAPI_KEY_1–5 are extras.
# Get keys at https://serpapi.com
SERPAPI_KEY=
SERPAPI_KEY_1=
SERPAPI_KEY_2=
SERPAPI_KEY_3=
SERPAPI_KEY_4=
SERPAPI_KEY_5=
